# Copy this file to .env.local and fill in the two values from your
# Supabase project: Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Shared password for the not-yet-public /impact page. Server-side only:
# do NOT add a NEXT_PUBLIC_ prefix, or it would be compiled into the browser
# bundle. With this unset the page is closed to everyone.
IMPACT_PASSWORD=choose-a-passphrase
